FROM alpine:3.24 AS builder

WORKDIR /src

# Keep tool bootstrap and third-party dependency compilation ahead of COPY . so
# ordinary subconverter source changes reuse the expensive dependency layer.
RUN apk add --no-cache bash git
COPY scripts/build.alpine.release.sh /usr/local/bin/subconverter-build
RUN chmod +x /usr/local/bin/subconverter-build \
    && /usr/local/bin/subconverter-build dependencies

COPY . .

ARG SKIP_RULE_UPDATE=0
RUN SKIP_RULE_UPDATE="$SKIP_RULE_UPDATE" /usr/local/bin/subconverter-build project

FROM alpine:3.24

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /base
COPY --from=builder /src/subconverter/ /base/

EXPOSE 25500
CMD ["./subconverter"]
